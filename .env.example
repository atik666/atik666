# Frontend environment variables
# Replace <project-ref> with your Supabase project ref, e.g., abcd1234
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Server-side only (do NOT commit real values)
RESEND_API_KEY=your_resend_api_key
CONTACT_TO=faculty@example.edu
# Use a verified sender domain (or onboarding@resend.dev while testing)
CONTACT_FROM=Website Contact <onboarding@resend.dev>
# Optional: who should replies go to (often your own address)
REPLY_TO=you@example.edu